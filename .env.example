# Copy to .env for local development. Never commit .env.
ENV=development
API_BASE_URL=http://localhost:8000
DATABASE_URL=postgresql+psycopg://cardiosens:cardiosens@localhost:5432/cardiosens

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
SIGNING_KEY=change-me

# Development only: returns the SMS code in the API response so you can sign in without SMS.
DEV_EXPOSE_OTP=true
SMS_PROVIDER=console
# Production: SMS_PROVIDER=msg91 with a DLT-approved OTP template that contains ##OTP##.
# MSG91_AUTH_KEY=
# MSG91_TEMPLATE_ID=

STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./var/storage
# STORAGE_BACKEND=s3
# S3_BUCKET=cardiosensai-prod-artefacts
# S3_REGION=ap-south-1

# JSON list, e.g. ["https://dashboard.cardiosensai.example"]
CORS_ORIGINS=[]
