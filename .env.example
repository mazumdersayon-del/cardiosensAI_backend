# Copy to .env for local development. Never commit .env.
ENV=development
API_BASE_URL=http://localhost:8000
DATABASE_URL=postgresql+psycopg://cardiosens:cardiosens@localhost:5432/cardiosens

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
SIGNING_KEY=change-me

# Development only: returns the SMS code in the API response so you can sign in without SMS.
DEV_EXPOSE_OTP=true
SMS_PROVIDER=console
# Production: SMS_PROVIDER=msg91 (set it up on the server with scripts/setup_msg91.sh), or none
# (then sign-up needs an email and leaves the number unconfirmed; SMS sign-in answers 503 sms_unavailable).
# MSG91_AUTH_KEY=
# MSG91_OTP_TEMPLATE_ID=        # DLT OTP template with ##OTP##
# MSG91_NOTICE_TEMPLATE_ID=     # optional: "this number already has an account"

# Email + password sign-in. Links in emails point at the web app.
WEB_BASE_URL=http://localhost:5173
# console: emails (with their links) are written to the log. Production needs smtp.
EMAIL_PROVIDER=console
# EMAIL_PROVIDER=smtp
# EMAIL_FROM=CardiosensAI <no-reply@cardiosens.ai>
# SMTP_HOST=smtppro.zoho.in
# SMTP_PORT=587
# SMTP_TLS=starttls
# SMTP_USERNAME=no-reply@cardiosens.ai
# SMTP_PASSWORD=

STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./var/storage
# STORAGE_BACKEND=s3
# S3_BUCKET=cardiosensai-prod-artefacts
# S3_REGION=ap-south-1

# JSON list, e.g. ["https://dashboard.cardiosensai.example"]
CORS_ORIGINS=[]
